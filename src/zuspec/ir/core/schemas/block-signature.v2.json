{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "zuspec.block-signature.v2",
 "title": "Zuspec block signature (v1 is read too: no stage/flop_kind)",
 "type": "object",
 "required": [
  "format",
  "version",
  "name"
 ],
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "zuspec.block-signature"
  },
  "version": {
   "enum": [
    1,
    2
   ]
  },
  "name": {
   "type": "string"
  },
  "engine": {
   "type": [
    "string",
    "null"
   ]
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "clock": {
   "type": [
    "string",
    "null"
   ]
  },
  "reset": {
   "type": [
    "string",
    "null"
   ]
  },
  "reset_active_low": {
   "type": "boolean"
  },
  "latency": {
   "type": [
    "integer",
    "null"
   ]
  },
  "initiation_interval": {
   "type": [
    "integer",
    "null"
   ]
  },
  "channels": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "direction",
     "payload"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "direction": {
      "enum": [
       "in",
       "out"
      ]
     },
     "flow_control": {
      "enum": [
       "ready_valid",
       "valid",
       "none"
      ]
     },
     "ports": {
      "type": "object",
      "propertyNames": {
       "enum": [
        "data",
        "valid",
        "ready"
       ]
      },
      "additionalProperties": {
       "type": "string"
      }
     },
     "payload": {
      "$comment": "A DataType as signature JSON: int, struct or array (signature.py _payload_to_json).",
      "type": [
       "object",
       "null"
      ]
     },
     "payload_sv_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "stage": {
      "type": [
       "integer",
       "null"
      ]
     },
     "flop_kind": {
      "enum": [
       "none",
       "flop",
       "skid",
       "zero_latency",
       null
      ]
     }
    }
   }
  }
 }
}
