{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "zuspec.block-signature.v3",
 "title": "Zuspec block signature (v1 and v2 are read too: v1 has no stage/flop_kind; neither has kind/data_ports/valid_ports)",
 "type": "object",
 "required": [
  "format",
  "version",
  "name"
 ],
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "zuspec.block-signature"
  },
  "version": {
   "enum": [
    1,
    2,
    3
   ]
  },
  "name": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "proc",
    "function"
   ]
  },
  "engine": {
   "type": [
    "string",
    "null"
   ]
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "clock": {
   "type": [
    "string",
    "null"
   ]
  },
  "reset": {
   "type": [
    "string",
    "null"
   ]
  },
  "reset_active_low": {
   "type": "boolean"
  },
  "latency": {
   "type": [
    "integer",
    "null"
   ]
  },
  "initiation_interval": {
   "type": [
    "integer",
    "null"
   ]
  },
  "channels": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "direction",
     "payload"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "direction": {
      "enum": [
       "in",
       "out"
      ]
     },
     "flow_control": {
      "enum": [
       "ready_valid",
       "valid",
       "none"
      ]
     },
     "ports": {
      "type": "object",
      "propertyNames": {
       "enum": [
        "data",
        "valid",
        "ready"
       ]
      },
      "additionalProperties": {
       "type": "string"
      }
     },
     "payload": {
      "anyOf": [
       {
        "$ref": "#/$defs/payload"
       },
       {
        "type": "null"
       }
      ]
     },
     "payload_sv_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "stage": {
      "type": [
       "integer",
       "null"
      ]
     },
     "flop_kind": {
      "enum": [
       "none",
       "flop",
       "skid",
       "zero_latency",
       null
      ]
     }
    }
   }
  },
  "data_ports": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "direction",
     "type"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "direction": {
      "enum": [
       "in",
       "out"
      ]
     },
     "type": {
      "$ref": "#/$defs/payload"
     },
     "sv_type": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "valid_ports": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "input_valid",
     "output_valid"
    ]
   },
   "additionalProperties": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "payload": {
   "$comment": "A DataType as signature JSON (signature.py _payload_to_json).",
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "int",
      "array",
      "struct"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "int"
       }
      }
     },
     "then": {
      "required": [
       "bits"
      ],
      "properties": {
       "bits": {
        "type": "integer"
       },
       "signed": {
        "type": "boolean"
       },
       "four_state": {
        "$comment": "4-state bits (SV logic). Written only when true; absent means 2-state or unstated. Additive, so no version bump.",
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "array"
       }
      }
     },
     "then": {
      "required": [
       "size",
       "element"
      ],
      "properties": {
       "size": {
        "type": "integer"
       },
       "element": {
        "$ref": "#/$defs/payload"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "struct"
       }
      }
     },
     "then": {
      "required": [
       "fields"
      ],
      "properties": {
       "name": {
        "type": [
         "string",
         "null"
        ]
       },
       "fields": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "name",
          "type"
         ],
         "properties": {
          "name": {
           "type": "string"
          },
          "type": {
           "$ref": "#/$defs/payload"
          }
         }
        }
       }
      }
     }
    }
   ]
  }
 }
}
